-- =========================================================
-- HÀM HỖ TRỢ: BAY MƯỢT (TWEEN) TRÁNH ANTI-CHEAT
-- =========================================================
local function TweenTo(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char.HumanoidRootPart
    local dist = (root.Position - targetCFrame.Position).Magnitude
    local time = dist / (speed or 250) -- Tốc độ bay chuẩn 250
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    
    -- Tắt va chạm tránh mắc kẹt địa hình
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    
    tween:Play()
    return tween
end

-- =========================================================
-- 1. TAB AUTO FARM
-- =========================================================
local FarmToggle = Tabs.Farm:AddToggle("FarmToggle", {Title = "Bật Auto Farm Level & Quái", Default = false})
FarmToggle:OnChanged(function() _G.AutoFarm = FarmToggle.Value end)

task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                -- Tìm quái gần nhất
                local targetMob = nil
                local minDist = math.huge
                local mobFolder = workspace:FindFirstChild("Monster") or workspace:FindFirstChild("Enemies") or workspace
                
                for _, mob in pairs(mobFolder:GetChildren()) do
                    if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            targetMob = mob
                        end
                    end
                end
                
                if targetMob then
                    -- Bay đến phía trên đầu quái 5 studs
                    local targetPos = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    TweenTo(targetPos, 300)
                    
                    -- Cầm vũ khí
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            char.Humanoid:EquipTool(tool)
                        end
                    end
                    
                    -- Tự động đánh
                    local weapon = char:FindFirstChildOfClass("Tool")
                    if weapon then weapon:Activate() end
                    game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                end
            end)
        end
    end
end)

