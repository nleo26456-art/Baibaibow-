local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "BAIBAIBOW HUB | King Legacy",
    SubTitle = "Bản Auto Farm Đánh Quái",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Auto Farm", Icon = "rbxassetid://4483345998" }),
    Misc = Window:AddTab({ Title = "Cài Đặt / Giảm Lag", Icon = "rbxassetid://4483345998" })
}

-- Biến lưu trạng thái
_G.AutoFarm = false

Tabs.Main:AddParagraph({
    Title = "Hệ Thống Auto Farm",
    Content = "Bật công tắc bên dưới, nhân vật sẽ tự bay tới quái gần nhất và đánh."
})

local FarmToggle = Tabs.Main:AddToggle("AutoFarmToggle", {Title = "Bật Auto Farm Quái Gần Nhất", Default = false})

FarmToggle:OnChanged(function()
    _G.AutoFarm = FarmToggle.Value
    if _G.AutoFarm then
        Fluent:Notify({Title = "Wukong Hub", Content = "Đã BẬT Auto Farm!", Duration = 3})
    else
        Fluent:Notify({Title = "Wukong Hub", Content = "Đã TẮT Auto Farm!", Duration = 3})
    end
end)

-- =========================================================
-- VÒNG LẶP LOGIC XỬ LÝ AUTO FARM (ĐÁNH QUÁI THỰC TẾ)
-- =========================================================
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoFarm then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                -- 1. Tìm quái còn sống gần nhất trong game
                local targetMob = nil
                local minDistance = math.huge
                
                -- Tìm quái ở các thư mục chứa quái phổ biến của King Legacy
                local mobFolder = workspace:FindFirstChild("Monster") or workspace:FindFirstChild("Enemies") or workspace

                for _, v in pairs(mobFolder:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                        if dist < minDistance then
                            minDistance = dist
                            targetMob = v
                        end
                    end
                end

                -- 2. Nếu tìm thấy quái -> Tự bay tới và Tấn công
                if targetMob then
                    -- Bật Noclip (Xuyên tường để không bị dính địa hình)
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then 
                            part.CanCollide = false 
                        end
                    end

                    -- Dịch chuyển đứng trên đầu quái 6 studs (khoảng cách an toàn)
                    char.HumanoidRootPart.CFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(math.rad(-90), 0, 0)

                    -- Tự trang bị vũ khí từ balo (Backpack)
                    for _, tool in pairs(player.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            char.Humanoid:EquipTool(tool)
                        end
                    end

                    -- Tự bấm đánh
                    local equippedTool = char:FindFirstChildOfClass("Tool")
                    if equippedTool then
                        equippedTool:Activate()
                    end
                    
                    -- Giả lập click chuột liên tục
                    game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                end
            end)
        end
    end
end)

-- Mặc định chọn Tab 1
Window:SelectTab(1)
