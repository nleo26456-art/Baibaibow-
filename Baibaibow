-- Tải thư viện giao diện Fluent UI (Giao diện Genesis Style - Không Key)
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- Khởi tạo cửa sổ Menu Genesis
local Window = Fluent:CreateWindow({
    Title = "GENESIS HUB | King Legacy",
    SubTitle = "Update mới nhất • No Key",
    TabWidth = 160,
    Size = UDim2.fromOffset(560, 380),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- Tạo các Tab điều hướng
local Tabs = {
    Main = Window:AddTab({ Title = "Auto Farm", Icon = "sword" }),
    Stats = Window:AddTab({ Title = "Stats", Icon = "user" }),
    Teleport = Window:AddTab({ Title = "Teleport", Icon = "map-pin" }),
    Misc = Window:AddTab({ Title = "Player & ESP", Icon = "shield" })
}

-- Cấu hình biến toàn cục
_G.AutoFarmLevel = false
_G.SelectWeapon = "Melee"
_G.AutoStats = false
_G.SelectedStat = "Melee"
_G.InfJump = false

--------------------------------------------------------------------------------
-- 1. TAB AUTO FARM
--------------------------------------------------------------------------------
Tabs.Main:AddSection("Thiết lập vũ khí")

Tabs.Main:AddDropdown("WeaponSelect", {
    Title = "Chọn loại vũ khí đánh",
    Values = {"Melee", "Sword", "Blox Fruit"},
    Default = "Melee",
    Callback = function(Value)
        _G.SelectWeapon = Value
    end
})

Tabs.Main:AddSection("Tự động Cày cấp")

Tabs.Main:AddToggle("AutoFarmToggle", {
    Title = "Bật/Tắt Auto Farm Level",
    Default = false,
    Callback = function(Value)
        _G.AutoFarmLevel = Value
    end
})

-- Vòng lặp xử lý Auto Farm
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoFarmLevel then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                -- Tự trang bị vũ khí chọn sẵn
                for _, tool in pairs(player.Backpack:GetChildren()) do
                    if tool:IsA("Tool") and (tool.ToolTip == _G.SelectWeapon or tool.Name:find(_G.SelectWeapon)) then
                        char.Humanoid:EquipTool(tool)
                    end
                end

                -- Tìm quái gần nhất để farm
                local monsters = workspace:FindFirstChild("Monsters") or workspace:FindFirstChild("Enemies") or workspace
                for _, v in pairs(monsters:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        -- Giữ khoảng cách an toàn phía trên quái (Anti-Damage)
                        char.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0)
                        
                        -- Kích hoạt đòn đánh
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        
                        -- Giả lập click chuột/chạm màn hình
                        game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        break
                    end
                end
            end)
        end
    end
end)

--------------------------------------------------------------------------------
-- 2. TAB AUTO STATS
--------------------------------------------------------------------------------
Tabs.Stats:AddSection("Cộng điểm chỉ số")

Tabs.Stats:AddDropdown("StatSelect", {
    Title = "Chọn chỉ số nâng",
    Values = {"Melee", "Defense", "Sword", "Demon Fruit"},
    Default = "Melee",
    Callback = function(Value)
        _G.SelectedStat = Value
    end
})

Tabs.Stats:AddToggle("AutoStatToggle", {
    Title = "Tự động cộng điểm (Auto Add Stats)",
    Default = false,
    Callback = function(Value)
        _G.AutoStats = Value
    end
})

-- Vòng lặp tự động gửi Remote cộng điểm
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoStats then
            pcall(function()
                local args = { [1] = _G.SelectedStat, [2] = 1 }
                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("StatFunction") then
                    remotes.StatFunction:InvokeServer(unpack(args))
                end
            end)
        end
    end
end)

--------------------------------------------------------------------------------
-- 3. TAB TELEPORT
--------------------------------------------------------------------------------
Tabs.Teleport:AddSection("Dịch chuyển nhanh (Biển 1)")

Tabs.Teleport:AddButton({
    Title = "Đảo Khởi Đầu (Starter Island)",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(-25, 50, 1050)
        end
    end
})

Tabs.Teleport:AddButton({
    Title = "Đảo Cát (Desert Island)",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(1000, 50, -1500)
        end
    end
})

--------------------------------------------------------------------------------
-- 4. TAB MISC & PLAYER
--------------------------------------------------------------------------------
Tabs.Misc:AddSection("Cài đặt nhân vật")

Tabs.Misc:AddSlider("SpeedSlider", {
    Title = "Tốc độ di chuyển",
    Default = 16,
    Min = 16,
    Max = 200,
    Rounding = 0,
    Callback = function(Value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = Value
        end
    end
})

Tabs.Misc:AddToggle("InfJumpToggle", {
    Title = "Nhảy vô hạn (Infinite Jump)",
    Default = false,
    Callback = function(Value)
        _G.InfJump = Value
    end
})

-- Lắng nghe sự kiện Nhảy
game:GetService("UserInputService").JumpRequest:Connect(function()
    if _G.InfJump then
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        end
    end
end)

-- Hiển thị thông báo khi tải xong
Fluent:Notify({
    Title = "Genesis Hub Loaded",
    Content = "Đã tải thành công script King Legacy (No Key)!",
    Duration = 5
})
